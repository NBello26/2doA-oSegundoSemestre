--Excepcion creada por nosotros
SET SERVEROUTPUT ON;
DECLARE
edad_inf EXCEPTION;
v_edad NUMBER:=15;
BEGIN
    IF(v_edad<15)THEN
     RAISE edad_inf;
    END IF;
        DBMS_OUTPUT.PUT_LINE('Acceso permitido');
    EXCEPTION
    WHEN edad_inf THEN
        DBMS_OUTPUT.PUT_LINE('Edad insuficiente, Acceso denegado ');
END;


--Excepcion creada por nosotros con bd
--Aumentar salario en un 20%
--Definir limite de salario en 9.000, si supera el limite debe
--mostrar un mensaje por consola
DECLARE
sueldo_exc EXCEPTION;
v_sueldo_plus NUMBER; 
CURSOR CUR_EMP
    IS 
    SELECT 
        FIRST_NAME || ' ' ||LAST_NAME as EMP_NOMBRE,
        SALARY as Sueldo
        FROM EMPLOYEES;
BEGIN
    FOR REC_EMP IN CUR_EMP LOOP
        BEGIN
            DBMS_OUTPUT.PUT_LINE(' ');
            v_sueldo_plus:= REC_EMP.Sueldo*1.2;
            IF(v_sueldo_plus>9000)THEN
                RAISE sueldo_exc;
            END IF;
                DBMS_OUTPUT.PUT_LINE('Acceso permitido, el sueldo del empleado ' || REC_EMP.EMP_NOMBRE || ' a sido aumentado de ' || REC_EMP.Sueldo || ' a ' || v_sueldo_plus);
            EXCEPTION
            WHEN sueldo_exc THEN
                DBMS_OUTPUT.PUT_LINE('Acceso DENEGADO, el sueldo del empleado ' || REC_EMP.EMP_NOMBRE || ' al ser aumentado de ' || REC_EMP.Sueldo || ' a ' || v_sueldo_plus || ' supera el limite permitido');
        END;
    END LOOP;
END;
