--Trigger
CREATE OR REPLACE TRIGGER Guardar_Transaccion
BEFORE UPDATE OR INSERT OR DELETE ON Employees
FOR EACH ROW
BEGIN
    IF INSERTING THEN
        INSERT INTO AUDITORIA(ID_AUDITORIA, FECHA_INGRESO, TIPO_TRANSACCION,EMPLOYEE_ID) VALUES(SEQ_AUDITORIA.NEXTVAL,SYSDATE,'Insert',:NEW.EMPLOYEE_ID);
    ELSIF UPDATING THEN
        INSERT INTO AUDITORIA(ID_AUDITORIA, FECHA_INGRESO, TIPO_TRANSACCION,EMPLOYEE_ID) VALUES(SEQ_AUDITORIA.NEXTVAL,SYSDATE,'Update',:OLD.EMPLOYEE_ID);
    ELSIF DELETING THEN
        INSERT INTO AUDITORIA(ID_AUDITORIA, FECHA_INGRESO, TIPO_TRANSACCION,EMPLOYEE_ID) VALUES(SEQ_AUDITORIA.NEXTVAL,SYSDATE,'Delete',:OLD.EMPLOYEE_ID);
    END IF;
END;

--Crear tabla auditoria

CREATE TABLE AUDITORIA (
    ID_AUDITORIA     NUMBER(10)        PRIMARY KEY,
    FECHA_INGRESO    DATE              ,
    TIPO_TRANSACCION VARCHAR2(20)      NOT NULL,
    EMPLOYEE_ID      NUMBER(10)
);

-- Crear secuencia
CREATE SEQUENCE SEQ_AUDITORIA
START WITH 1
INCREMENT BY 1
NOCACHE;


