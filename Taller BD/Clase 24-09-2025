CREATE OR REPLACE PROCEDURE actualizar_empleado(
  p_id NUMBER
) IS


BEGIN

  SELECT SALARY, FIRST_NAME,LAST_NAME
    INTO p_salario, p_nombre, p_apellido
    FROM EMPLOYEES
    WHERE EMPLOYEE_ID = p_id;

  aumentar_salario(p_salario);
  concatenar_nombre(p_nombre,p_apellido);
  
  UPDATE employees 

  SET first_name = p_nombre, 

    last_name = p_apellido,

    salary = p_salario

  WHERE employee_id = p_id;

   

  DBMS_OUTPUT.PUT_LINE('Empleado actualizado completamente');
END;
