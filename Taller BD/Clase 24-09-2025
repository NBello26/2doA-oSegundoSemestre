SET SERVEROUTPUT ON;
CREATE OR REPLACE FUNCTION aumentar_salario (
    p_salario NUMBER
)
RETURN NUMBER
IS  
    v_resultado NUMBER;
BEGIN
    -- Lógica de la función
    IF p_salario < 25000 THEN
        v_resultado := p_salario * 1.15; -- Ejemplo: suma de parámetros
        DBMS_OUTPUT.PUT_LINE('El salario fue aumentado en un 15%');
    ELSE
        v_resultado := p_salario;
        DBMS_OUTPUT.PUT_LINE('El salario no fue aumentado');
    END IF;
    
    RETURN v_resultado;
EXCEPTION
    WHEN OTHERS THEN
        -- Manejo de errores
        DBMS_OUTPUT.PUT_LINE('Error: ' || SQLERRM);
        RETURN NULL; -- o un valor por defecto
END;



